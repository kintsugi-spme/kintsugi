mpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="valida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003E7E;strokeWidth=1.5;fontSize=10;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003E7E;strokeWidth=1.5;fontSize=10;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="sync: salva_ordine()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003E7E;strokeWidth=1.5;fontSize=10;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="async: pubblica()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003E7E;strokeWidth=1.5;fontSize=10;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="legge la coda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003E7E;strokeWidth=1.5;fontSize=10;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="chiama salva(), ricevuta da main" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#003E7E;strokeWidth=1.5;fontSize=10;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003E7E;strokeWidth=1.5;fontSize=10;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003E7E;strokeWidth=1.5;fontSize=10;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="Frecce piene: un modulo importa e usa l'altro. Freccia tratteggiata: &lt;code&gt;worker.py&lt;/code&gt; non importa &lt;code&gt;servizio.py&lt;/code&gt;; riceve da &lt;code&gt;main.py&lt;/code&gt; la funzione salva() e la chiama per ogni ordine. &lt;code&gt;main.py&lt;/code&gt; usa anche &lt;code&gt;db.py&lt;/code&gt; e &lt;code&gt;broker.py&lt;/code&gt; per aprire pool e connessione." style="text;html=1;fontColor=#5A5A5A;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1000" y="450" width="330" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
